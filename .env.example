# Copiar a .env (que NO se versiona) y completar. Nunca escribir valores reales aquí.

# Proveedores LLM (orden por defecto en config.yaml: openai -> anthropic -> opencode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# Opcional: fuerza el proveedor principal (openai | anthropic | opencode)
ASSISTANT_PROVIDER=

# Opcional: ruta del JSONL de métricas (por defecto data/chat_metrics.jsonl)
CHAT_METRICS_PATH=
